<Window
    x:Class="BreakReminderWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon FontSize="16" Glyph="&#xE7B3;" Foreground="{ThemeResource BreakAccentBrush}" />
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="20-20 Break" />
                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Eye care reminder" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="32,20,32,32">
            <Border
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Padding="32"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="8">
                        <Border HorizontalAlignment="Left" Padding="12,6" Background="{ThemeResource BreakAccentSoftBrush}" CornerRadius="999">
                            <TextBlock x:Name="ModeLabel" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BreakAccentBrush}" Text="REMINDER ACTIVE" />
                        </Border>
                        <TextBlock x:Name="HeadingText" Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Text="Your next eye break" />
                        <TextBlock x:Name="BodyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Every 20 minutes, look at something 20 feet away for 20 seconds." TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="72" FontWeight="SemiBold" Text="20:00" />
                    <ProgressBar x:Name="CountdownProgress" Height="8" Maximum="100" Value="0" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Protect your focus" />
                            <TextBlock x:Name="DetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The timer keeps counting while this window is open." />
                        </StackPanel>
                        <Button x:Name="PrimaryButton" Grid.Column="1" Padding="18,10" Click="PrimaryButton_Click" Style="{StaticResource AccentButtonStyle}" Content="Start break now" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
