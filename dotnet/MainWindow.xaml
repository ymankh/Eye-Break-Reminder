<Window
    x:Class="BreakReminderDotNet10.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="20-20 Break">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="20-20 Break">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel
            Grid.Row="1"
            Margin="20,12,20,0"
            Spacing="14"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="ModeText"
                HorizontalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Active" />
            <TextBlock
                x:Name="CountdownText"
                HorizontalAlignment="Center"
                FontSize="52"
                FontWeight="SemiBold"
                Text="20:00" />
            <ProgressBar
                x:Name="CountdownProgress"
                Minimum="0"
                Maximum="100"
                ShowPaused="False"
                ShowError="False"
                Value="100" />
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Next break in 20:00."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="HideButton"
                Click="HideButton_Click"
                Content="Hide" />
            <Button
                x:Name="ActionButton"
                Click="ActionButton_Click"
                Content="Start break" />
        </StackPanel>
    </Grid>
</Window>
