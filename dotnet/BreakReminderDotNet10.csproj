<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BreakReminderDotNet10</AssemblyName>
    <PublishedExecutableName>20-20 Break.exe</PublishedExecutableName>
    <Product>20-20 Break</Product>
    <Description>20-20 Break reminder</Description>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.1.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AssemblyInfo.cs" />
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="artifacts\**\*;installer\bin\**\*;installer\obj\**\*;publish\**\*;TestResults\**\*" />
    <None Remove="artifacts\**\*;installer\bin\**\*;installer\obj\**\*;publish\**\*;TestResults\**\*" />
  </ItemGroup>

  <Target Name="RenamePublishedExecutable" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_PublishedAssemblyExecutable>$(PublishDir)$(AssemblyName).exe</_PublishedAssemblyExecutable>
      <_PublishedProductExecutable>$(PublishDir)$(PublishedExecutableName)</_PublishedProductExecutable>
      <_PublishedAssemblyPri>$(PublishDir)$(AssemblyName).pri</_PublishedAssemblyPri>
      <_PublishedProductPri>$(PublishDir)$([System.IO.Path]::GetFileNameWithoutExtension('$(PublishedExecutableName)')).pri</_PublishedProductPri>
    </PropertyGroup>

    <Delete
      Files="$(_PublishedProductExecutable)"
      Condition="'$(PublishedExecutableName)' != '' and Exists('$(_PublishedProductExecutable)') and '$(_PublishedAssemblyExecutable)' != '$(_PublishedProductExecutable)'" />

    <Move
      SourceFiles="$(_PublishedAssemblyExecutable)"
      DestinationFiles="$(_PublishedProductExecutable)"
      Condition="'$(PublishedExecutableName)' != '' and Exists('$(_PublishedAssemblyExecutable)') and '$(_PublishedAssemblyExecutable)' != '$(_PublishedProductExecutable)'" />

    <Copy
      SourceFiles="$(_PublishedAssemblyPri)"
      DestinationFiles="$(_PublishedProductPri)"
      SkipUnchangedFiles="true"
      Condition="'$(PublishedExecutableName)' != '' and Exists('$(_PublishedAssemblyPri)') and '$(_PublishedAssemblyPri)' != '$(_PublishedProductPri)'" />
  </Target>

  <Target Name="CopyWinUiPublishArtifacts" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true' and '$(WindowsAppSDKSelfContained)' == 'true'">
    <ItemGroup>
      <_WinUiCompiledArtifacts Include="$(OutDir)**\*.xbf;$(OutDir)**\*.pri" Exclude="$(PublishDir)**\*" />
      <_WinUiFrameworkAssets Include="$(OutDir)Microsoft.UI.Xaml\Assets\**\*" Exclude="$(PublishDir)**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_WinUiCompiledArtifacts)"
      DestinationFiles="@(_WinUiCompiledArtifacts->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_WinUiCompiledArtifacts)' != ''" />

    <Copy
      SourceFiles="@(_WinUiFrameworkAssets)"
      DestinationFiles="@(_WinUiFrameworkAssets->'$(PublishDir)Microsoft.UI.Xaml\Assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_WinUiFrameworkAssets)' != ''" />
  </Target>
</Project>
