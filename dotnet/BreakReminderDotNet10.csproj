<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>20-20 Break</AssemblyName>
    <Product>20-20 Break</Product>
    <Description>20-20 Break reminder</Description>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AssemblyInfo.cs" />
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="publish\**\*;artifacts\**\*;TestResults\**\*" />
    <None Remove="publish\**\*;artifacts\**\*;TestResults\**\*" />
  </ItemGroup>

  <Target Name="CopyWinUiPublishArtifacts" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <_WinUiCompiledArtifacts Include="$(OutDir)**\*.xbf;$(OutDir)**\*.pri" Exclude="$(PublishDir)**\*" />
      <_WinUiFrameworkAssets Include="$(OutDir)Microsoft.UI.Xaml\Assets\**\*" Exclude="$(PublishDir)**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_WinUiCompiledArtifacts)"
      DestinationFiles="@(_WinUiCompiledArtifacts->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_WinUiCompiledArtifacts)' != ''" />

    <Copy
      SourceFiles="@(_WinUiFrameworkAssets)"
      DestinationFiles="@(_WinUiFrameworkAssets->'$(PublishDir)Microsoft.UI.Xaml\Assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_WinUiFrameworkAssets)' != ''" />
  </Target>
</Project>
