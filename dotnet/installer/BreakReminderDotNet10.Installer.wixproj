<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <InstallerVersion Condition="'$(InstallerVersion)' == ''">1.0.0</InstallerVersion>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildProjectDirectory)\..\publish\win-x64-single-file</AppPublishDir>
    <AcceptEula>wix7</AcceptEula>
    <DefineConstants>InstallerVersion=$(InstallerVersion);AppPublishDir=$(AppPublishDir)</DefineConstants>
    <OutputType>Package</OutputType>
    <OutputName>20-20 Break-$(InstallerVersion)-x64</OutputName>
    <Platform>x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Bundle.wxs" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
