<?xml version="1.0" encoding="UTF-8"?>
<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="20-20 Break"
    Manufacturer="BreakReminderDotNet10"
    Version="$(var.InstallerVersion)"
    UpgradeCode="A7A63EFC-65D3-48B2-95F1-2AC64CBF587E"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="..\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Launch
      Condition="VersionNT64"
      Message="20-20 Break requires 64-bit Windows." />
    <Launch
      Condition="VersionNT &gt;= 1000"
      Message="20-20 Break requires Windows 10 or newer." />

    <ui:WixUI Id="WixUI_InstallDir" />

    <Feature Id="MainFeature" Title="20-20 Break" Level="1">
      <ComponentRef Id="ApplicationExecutableComponent" />
      <ComponentRef Id="ShortcutComponent" />
      <ComponentRef Id="StartupComponent" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="20-20 Break" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="20-20 Break" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationExecutableComponent" Guid="*">
        <File Id="BreakReminderExe" Source="$(var.AppPublishDir)\BreakReminderDotNet10.exe" KeyPath="yes" Checksum="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ShortcutComponent" Guid="*">
        <Shortcut
          Id="StartMenuShortcut"
          Name="20-20 Break"
          Description="Start 20-20 Break"
          Target="[#BreakReminderExe]"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico" />
        <Shortcut
          Id="DesktopShortcut"
          Directory="DesktopFolder"
          Name="20-20 Break"
          Description="Start 20-20 Break"
          Target="[#BreakReminderExe]"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\BreakReminderDotNet10"
          Name="ShortcutsInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="StartupComponent" Guid="*">
        <RegistryValue
          Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="20-20 Break"
          Type="string"
          Value="&quot;[#BreakReminderExe]&quot;"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
